# Copy to .env.local for local development.
# Also set these in Vercel: Project -> Settings -> Environment Variables.

# Supabase (safe to expose — protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Server-only (never NEXT_PUBLIC_, never in the browser) ----

# Required for /api/checkout/paynow to persist quotes/policies/payments,
# for /api/claims (claim writes + Storage uploads), and for /api/auth/signup.
# Without it, those routes return 503 rather than pretending to succeed.
# Supabase project -> Settings -> API -> service_role.
# SUPABASE_SERVICE_ROLE_KEY=

# Paynow Zimbabwe (live). Server-only — the integration key signs every
# request with SHA512 and must never reach the browser bundle.
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=

# Required for the /private Super Admin console gate (app/api/private/login).
# Without these, /private always rejects login with a 503.
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# Not yet wired — future gateways / channels:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# RESEND_API_KEY=
